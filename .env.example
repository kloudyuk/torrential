# Storage (relative paths resolve from the project directory)
CONFIG_ROOT=./state/config
DATA_ROOT=./state/data

# Runtime identity
PUID=1000
PGID=1000
TZ=Europe/London
LOCALE=en-GB

# Web interfaces (trusted LAN access by default)
WEB_BIND_ADDRESS=0.0.0.0
# Stable Docker host LAN IP or local DNS name, without a scheme or port
TORRENTIAL_HOST=
DASHBOARD_PORT=80
SEERR_PORT=5055
SONARR_PORT=8989
RADARR_PORT=7878
PROWLARR_PORT=9696
TRANSMISSION_PORT=9091

# Plex
PLEX_PORT=32400
PLEX_HOSTNAME=torrential-plex

# Default acquisition quality used by Seerr
SEERR_SONARR_QUALITY_PROFILE=HD-1080p
SEERR_RADARR_QUALITY_PROFILE=HD-1080p

# VPN (required; consult Gluetun's setup page for the selected provider)
VPN_SERVICE_PROVIDER=nordvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
OPENVPN_PROTOCOL=udp
SERVER_COUNTRIES="United Kingdom"

# Logging
SEERR_LOG_LEVEL=info
FLARESOLVERR_LOG_LEVEL=info
